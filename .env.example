# Bot token from Discord Developer Portal 
DISCORD_BOT_TOKEN=

# ID of your server
DISCORD_GUILD_ID=

GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# https://docs.google.com/spreadsheets/d/<here>/edit
GOOGLE_SHEET_ID=

# Name of the worksheet (tab) that holds the member table.
GOOGLE_WORKSHEET_NAME=Members

# Role ID
HR_ROLE_IDS=

# The name of roles the bot can add/remove.
MANAGED_ROLES=Developer,Designer,HR,Content

# Channel ID that receives a short counts-only summary after each sync (leave empty to disable).
SYNC_LOG_CHANNEL_ID=

# Scheduled automatic sync (real sync, not a dry run). Disabled by default.
ENABLE_SCHEDULED_SYNC=false

# Minutes between scheduled syncs (minimum 5). The first run happens one interval after startup.
SCHEDULED_SYNC_INTERVAL_MINUTES=60

# Give a new member their role from the sheet (cant remove role)
ENABLE_JOIN_SYNC=false

# logs
LOG_DIR=logs
LOG_LEVEL=INFO